+// Temporary, bounded per-operation diagnostic timing; no query, URL or credential fields.
+use std::{future::{Future, poll_fn}, sync::atomic::{AtomicU64, AtomicUsize, Ordering}, time::{Duration, Instant}};
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+pub(super) fn next_id() -> u64 { NEXT_ID.fetch_add(1, Ordering::Relaxed) }
+#[derive(Clone, Copy)]
+pub(super) enum Phase { Permit, Ping, Before, Connect, Init, Backoff, Discard, Reset, ReleasePing, ReturnSchedule }
+impl Phase { fn index(self) -> usize { self as usize } }
+const NAMES: [&str; 10] = ["permit_wait", "checkout_ping", "before_acquire", "connect", "initialize", "connect_backoff", "discard", "release_reset", "release_ping", "return_schedule"];
+pub(super) struct Timing {
+ start: Instant, threshold: Duration, elapsed: [Duration; 10], active: Duration, max_poll: Duration, polls: u64,
+ pub id: u64, pool: u64, pub connection: u64, operation: &'static str, outcome: &'static str,
+ size_start: u32, idle_start: usize, waiters_start: usize, size_end: u32, idle_end: usize, waiters_end: usize, max: u32,
+ pub hold: Duration, pub span: tracing::Span, finished: Option<Duration>,
+}
+impl Timing {
+ pub fn new(operation: &'static str, pool: u64, threshold: Duration, size: u32, idle: usize, waiters: usize, max: u32) -> Self {
+  Self { start: Instant::now(), threshold, elapsed: [Duration::ZERO;10], active: Duration::ZERO, max_poll: Duration::ZERO, polls:0, id:next_id(), pool, connection:0, operation, outcome:"cancelled", size_start:size, idle_start:idle, waiters_start:waiters, size_end:size, idle_end:idle, waiters_end:waiters, max, hold:Duration::ZERO, span:tracing::Span::current(), finished:None }
+ }
+ pub fn returned_at(&mut self, at: Instant) { self.start=at; self.elapsed[Phase::ReturnSchedule.index()]=at.elapsed(); }
+ pub fn finish(&mut self, outcome: &'static str, size:u32, idle:usize, waiters:usize) { self.outcome=outcome;self.size_end=size;self.idle_end=idle;self.waiters_end=waiters;self.finished=Some(self.start.elapsed()); }
+ pub fn measure<'a, F: Future + 'a>(&'a mut self, phase: Phase, future:F) -> impl Future<Output=F::Output> + 'a {
+  let mut future=Box::pin(future);
+  async move {
+   let timer=Timer { observation:self, phase, start:Instant::now() };
+   poll_fn(|cx| { let start=Instant::now(); let result=future.as_mut().poll(cx); let active=start.elapsed(); timer.observation.active+=active;timer.observation.max_poll=timer.observation.max_poll.max(active);timer.observation.polls+=1; result }).await
+  }
+ }
+}
+struct Timer<'a> { observation:&'a mut Timing, phase:Phase, start:Instant }
+impl Drop for Timer<'_> { fn drop(&mut self) { self.observation.elapsed[self.phase.index()]+=self.start.elapsed(); } }
+impl Drop for Timing {
+ fn drop(&mut self) {
+  let total=self.finished.unwrap_or_else(||self.start.elapsed());
+  if total<self.threshold && self.hold<Duration::from_secs(2) { return; }
+  let sum:Duration=self.elapsed.iter().copied().sum(); let other=total.saturating_sub(sum);
+  let index=self.elapsed.iter().enumerate().max_by_key(|(_,v)|**v).map(|(i,_)|i).unwrap_or(0);
+  let dominant=if other>self.elapsed[index] {"unattributed"} else {NAMES[index]};
+  self.span.in_scope(|| tracing::warn!(target:"sqlx::pool::phase", diagnostic_version=1u32, operation=self.operation, operation_id=self.id, pool_id=self.pool, connection_id=self.connection, outcome=self.outcome, dominant_phase=dominant,
+   total_secs=total.as_secs_f64(), permit_wait_secs=self.elapsed[0].as_secs_f64(), checkout_ping_secs=self.elapsed[1].as_secs_f64(), before_acquire_secs=self.elapsed[2].as_secs_f64(), connect_secs=self.elapsed[3].as_secs_f64(), initialize_secs=self.elapsed[4].as_secs_f64(), connect_backoff_secs=self.elapsed[5].as_secs_f64(), discard_secs=self.elapsed[6].as_secs_f64(), release_reset_secs=self.elapsed[7].as_secs_f64(), release_ping_secs=self.elapsed[8].as_secs_f64(), return_schedule_secs=self.elapsed[9].as_secs_f64(), unattributed_secs=other.as_secs_f64(), active_poll_secs=self.active.as_secs_f64(), max_poll_secs=self.max_poll.as_secs_f64(), polls=self.polls, application_hold_secs=self.hold.as_secs_f64(), pool_size_start=self.size_start, pool_idle_start=self.idle_start, pool_waiters_start=self.waiters_start, pool_size_end=self.size_end, pool_idle_end=self.idle_end, pool_waiters_end=self.waiters_end, pool_max=self.max, "pool operation phase timings"));
+ }
+}
+pub(super) fn optional<'a, F: Future + 'a>(timing:Option<&'a mut Timing>,phase:Phase,future:F)->impl Future<Output=F::Output> + 'a {let future=Box::pin(future); async move {match timing {Some(t)=>t.measure(phase,future).await,None=>future.await}}}
+pub(super) struct Waiter<'a>(&'a AtomicUsize);
+impl<'a> Waiter<'a> { pub fn new(value:&'a AtomicUsize)->Self {value.fetch_add(1,Ordering::Relaxed);Self(value)} }
+impl Drop for Waiter<'_> {fn drop(&mut self) {self.0.fetch_sub(1,Ordering::Relaxed);}}
