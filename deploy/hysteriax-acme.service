[Unit]
Description=HysteriaX node certificate maintenance
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hysteriax-acme
Group=hysteriax-acme
SupplementaryGroups=hysteriax
WorkingDirectory=/var/lib/hysteriax
ExecStart=/opt/hysteriax/hysteriax-acme run /etc/hysteriax/acme.json
Restart=on-failure
RestartSec=60s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hysteriax-acme /var/lib/hysteriax/acme /var/lib/hysteriax/certificates
UMask=0027

[Install]
WantedBy=multi-user.target
